    style PRISMA_SERV fill:#E74C3C
    style ARTIST_CTRL fill:#50C878
    style ARTIST_SERV fill:#50C878
    style ALBUM_CTRL fill:#3498DB
    style ALBUM_SERV fill:#3498DB
