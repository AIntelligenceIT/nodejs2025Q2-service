graph TB
    subgraph "REST API ENDPOINTS"
        
        subgraph "Auth (Public - No JWT Required)"
            A1["POST /auth/signup<br/>{login, password}<br/>→ UserWithoutPassword"]
            A2["POST /auth/login<br/>{login, password}<br/>→ {accessToken, refreshToken}"]
            A3["POST /auth/refresh<br/>{refreshToken}<br/>→ {accessToken}"]
        end

        subgraph "Artists (Public)"
            AR1["POST /artist<br/>{name, grammy}<br/>→ Artist 201"]
            AR2["GET /artist<br/>→ Artist[]"]
            AR3["GET /artist/:id<br/>→ Artist"]
            AR4["PUT /artist/:id<br/>{name, grammy}<br/>→ Artist"]
            AR5["DELETE /artist/:id<br/>→ 204 No Content"]
        end

        subgraph "Albums (Public)"
            AL1["POST /album<br/>{name, year, artistId?}<br/>→ Album 201"]
            AL2["GET /album<br/>→ Album[]"]
            AL3["GET /album/:id<br/>→ Album"]
            AL4["PUT /album/:id<br/>{name, year, artistId?}<br/>→ Album"]
            AL5["DELETE /album/:id<br/>→ 204 No Content"]
        end

        subgraph "Tracks (Protected by JWT)"
            T1["GET /track<br/>→ Track[]"]
            T2["GET /track/:id<br/>→ Track"]
            T3["POST /track<br/>{name, duration, artistId?, albumId?}<br/>→ Track 201"]
            T4["PUT /track/:id<br/>{name, duration, artistId?, albumId?}<br/>→ Track"]
            T5["DELETE /track/:id<br/>→ 204 No Content"]
        end

        subgraph "Users (Mostly Protected)"
            U1["GET /user<br/>→ UserWithoutPassword[]"]
            U2["GET /user/:id<br/>→ UserWithoutPassword"]
            U3["PUT /user/:id/password<br/>{oldPassword, newPassword}<br/>→ UserWithoutPassword"]
            U4["DELETE /user/:id<br/>→ 204 No Content"]
        end

        subgraph "Favorites (Mostly Protected)"
            F1["GET /favorites<br/>→ {artists[], albums[], tracks[]}"]
            F2["POST /favorites/artist/:id<br/>→ Favorites 201"]
            F3["DELETE /favorites/artist/:id<br/>→ 200 OK"]
            F4["POST /favorites/album/:id<br/>→ Favorites 201"]
            F5["DELETE /favorites/album/:id<br/>→ 200 OK"]
            F6["POST /favorites/track/:id<br/>→ Favorites 201"]
            F7["DELETE /favorites/track/:id<br/>→ 200 OK"]
        end

        subgraph "Documentation"
            DOC["GET /doc<br/>→ Swagger/OpenAPI Documentation"]
        end
    end

    subgraph "Status Codes"
        S200["200 OK<br/>Successful GET/PUT"]
        S201["201 Created<br/>Successful POST"]
        S204["204 No Content<br/>Successful DELETE"]
        S400["400 Bad Request<br/>Invalid UUID/input"]
        S401["401 Unauthorized<br/>Invalid/missing JWT"]
        S403["403 Forbidden<br/>Insufficient permissions"]
        S404["404 Not Found<br/>Resource not found"]
        S422["422 Unprocessable Entity<br/>Entity doesn't exist<br/>(e.g., artist not found)"]
    end

    A1 --> S201
    A2 --> S200
    A3 --> S200
    A3 --> S401

    AR1 --> S201
    AR2 --> S200
    AR3 --> S200
    AR3 --> S404
