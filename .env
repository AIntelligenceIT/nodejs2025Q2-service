POSTGRES_PORT=5432
POSTGRES_USER=twoj_uzytkownik # np. postgres
# POSTGRES_PASSWORD=twoje_haslo
POSTGRES_PASSWORD=haselko
POSTGRES_DB=twoja_baza_danych # np. home_library

